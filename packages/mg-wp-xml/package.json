{
  "name": "@tryghost/mg-wp-xml",
  "version": "0.17.8-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/migrate.git",
    "directory": "packages/mg-wp-xml"
  },
  "author": "Ghost Foundation",
  "license": "MIT",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "test": "c8 --src src --all --check-coverage --100 --exclude '**/test/**' --exclude '**/*.d.ts' node --test 'build/test/**/*.test.js'",
    "test:local": "pnpm build && pnpm test",
    "test:stress": "node --max-old-space-size=256 test/stress.mjs"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "dependencies": {
    "@tryghost/errors": "catalog:",
    "@tryghost/mg-utils": "workspace:*",
    "@tryghost/string": "catalog:",
    "@tryghost/mg-wp-api": "workspace:*",
    "fast-glob": "3.3.3",
    "markdown-it": "catalog:",
    "php-serialize": "5.1.3",
    "@tryghost/mg-context": "workspace:*",
    "@tryghost/mg-ghost-authors": "workspace:*",
    "html-entities": "catalog:"
  },
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "devDependencies": {
    "typescript": "catalog:",
    "c8": "catalog:",
    "@types/node": "catalog:"
  }
}
