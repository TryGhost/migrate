{
  "name": "@tryghost/mg-beehiiv-api",
  "version": "0.7.8-0",
  "repository": "https://github.com/TryGhost/migrate/tree/main/packages/mg-beehiiv-api",
  "author": "Ghost Foundation",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "dev": "echo \"Implement me!\"",
    "build:watch": "tsc --watch --preserveWatchOutput --sourceMap",
    "build": "tsc --build --sourceMap",
    "test:local": "pnpm build && pnpm test",
    "test": "c8 --src src --all --check-coverage --100 --exclude '**/test/**' --exclude '**/*.d.ts' --reporter text --reporter cobertura node --test 'build/test/**/*.test.js'"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "c8": "catalog:",
    "nock": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tryghost/errors": "catalog:",
    "@tryghost/mg-beehiiv": "workspace:*",
    "@tryghost/mg-context": "workspace:*",
    "@tryghost/mg-ghost-authors": "workspace:*",
    "@tryghost/mg-utils": "workspace:*",
    "@tryghost/string": "catalog:"
  }
}
