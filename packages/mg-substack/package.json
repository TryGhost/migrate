{
  "name": "@tryghost/mg-substack",
  "version": "1.14.0-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/migrate.git",
    "directory": "packages/mg-substack"
  },
  "author": "Ghost Foundation",
  "license": "MIT",
  "main": "build/index.js",
  "type": "module",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "c8 --src src --all --check-coverage --100 --exclude '**/test/**' --exclude '**/*.d.ts' node --test 'build/test/**/*.test.js'",
    "test:local": "pnpm build && pnpm test"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "c8": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tryghost/debug": "catalog:",
    "@tryghost/mg-context": "workspace:*",
    "@tryghost/mg-fs-utils": "workspace:*",
    "@tryghost/mg-ghost-authors": "workspace:*",
    "@tryghost/mg-utils": "workspace:*",
    "@tryghost/string": "catalog:",
    "escape-string-regexp": "catalog:",
    "he": "2.0.0",
    "html-entities": "catalog:",
    "simple-dom": "catalog:",
    "srcset": "5.0.3"
  }
}
