{
  "name": "@tryghost/mg-context",
  "version": "0.11.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/migrate.git",
    "directory": "packages/mg-context"
  },
  "author": "Ghost Foundation",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "dev": "echo \"Implement me!\"",
    "build:watch": "tsc --watch --preserveWatchOutput --sourceMap",
    "build": "tsc --build --sourceMap",
    "sync:ghost-schema": "node scripts/sync-ghost-schema.mjs",
    "check:ghost-schema": "node scripts/sync-ghost-schema.mjs --check",
    "test": "c8 --src src --all --check-coverage --100 --reporter text --reporter cobertura node --test 'build/test/**/*.test.js'",
    "test:local": "pnpm build && pnpm test"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "devDependencies": {
    "@tryghost/listr-smart-renderer": "workspace:*",
    "@tryghost/mg-queue": "workspace:*",
    "@types/node": "catalog:"
  },
  "dependencies": {
    "@tryghost/errors": "catalog:",
    "@tryghost/string": "catalog:",
    "@tryghost/validator": "3.2.17",
    "c8": "catalog:",
    "typescript": "catalog:",
    "zod": "4.6.7"
  }
}
