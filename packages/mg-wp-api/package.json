{
  "name": "@tryghost/mg-wp-api",
  "version": "0.23.8-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/migrate.git",
    "directory": "packages/mg-wp-api"
  },
  "author": "Ghost Foundation",
  "license": "MIT",
  "main": "build/index.js",
  "type": "module",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "c8 --src src --all --check-coverage --100 --exclude '**/test/**' --exclude '**/*.d.ts' node --test 'build/test/**/*.test.js'",
    "test:local": "pnpm build && pnpm test"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "c8": "catalog:",
    "nock": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tryghost/errors": "catalog:",
    "@tryghost/mg-context": "workspace:*",
    "@tryghost/mg-fs-utils": "workspace:*",
    "@tryghost/mg-ghost-authors": "workspace:*",
    "@tryghost/mg-shortcodes": "workspace:*",
    "@tryghost/mg-utils": "workspace:*",
    "@tryghost/mg-webscraper": "workspace:*",
    "@tryghost/string": "catalog:",
    "html-to-text": "10.0.1",
    "simple-dom": "catalog:",
    "tldts": "7.4.19",
    "wpapi": "1.2.2"
  }
}
